+	 * the DMA API's own mappings), took an unbounded size, and its
+	 * buffers weren't tracked per session.  The code below is kept
+	 * unreachable so the file stays comparable with mack42's.
+	 */
+	dev_warn_once(rknpu_dev->dev,
+		      "mem_create: driver-allocated buffers are disabled; import a dma-buf instead\n");
+	return -EOPNOTSUPP;
+
 	buf = kzalloc(sizeof(*buf), GFP_KERNEL);
 	if (!buf)
 		return -ENOMEM;
@@ -837,24 +886,28 @@ int rknpu_mem_destroy_ioctl(struct rknpu_device *rknpu_dev, struct file *file,
 	spin_unlock(&rknpu_dev->lock);
 
 	if (found)
-		rknpu_mem_import_free(found);
+		rknpu_mem_put(found);
 
 	return 0;
 }
 
