+	obj = rknpu_mem_get(rknpu_dev, file->private_data, args.obj_addr);
+	if (!obj) {
 		LOG_DEV_ERROR(rknpu_dev->dev,
-			      "mem_sync: obj_addr=0 (flags=%#x offset=%llu size=%llu) -> EINVAL\n",
-			      args.flags, args.offset, args.size);
+			      "mem_sync: obj_addr %#llx is not one of this client's buffers (flags=%#x offset=%llu size=%llu) -> EINVAL\n",
+			      args.obj_addr, args.flags, args.offset, args.size);
 		return -EINVAL;
 	}
 
@@ -863,7 +916,7 @@ int rknpu_mem_sync_ioctl(struct rknpu_device *rknpu_dev, unsigned long data)
 	 * mem is the first member of rknpu_mem_buf so the two pointers
