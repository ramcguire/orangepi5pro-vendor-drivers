-		rknpu_mem_import_free(entry);
+		/* The list's reference; a job still using it holds its own. */
+		rknpu_mem_put(entry);
 	}
 
 	kfree(session);
@@ -612,6 +612,9 @@ static long rknpu_ioctl(struct file *file, unsigned int cmd, unsigned long arg)
 	if (size > sizeof(kdata))
 		return -EINVAL;
 
+	/* opi5: a short size must not leave stack garbage in kdata. */
+	memset(&kdata, 0, sizeof(kdata));
+
 	if (dir & _IOC_WRITE) {
 		if (copy_from_user(&kdata, uarg, size)) {
 			LOG_ERROR("%s: copy_from_user failed\n", __func__);
@@ -630,7 +633,8 @@ static long rknpu_ioctl(struct file *file, unsigned int cmd, unsigned long arg)
 		ret = rknpu_action_ioctl(rknpu_dev, &kdata.action);
 		break;
 	case RKNPU_SUBMIT:
-		ret = rknpu_submit_ioctl(rknpu_dev, &kdata.submit);
+		ret = rknpu_submit_ioctl(rknpu_dev, file->private_data,
+					 &kdata.submit);
 		break;
 	case RKNPU_MEM_CREATE:
 		ret = rknpu_mem_create_ioctl(rknpu_dev, file, cmd, arg);
@@ -641,7 +645,7 @@ static long rknpu_ioctl(struct file *file, unsigned int cmd, unsigned long arg)
 		ret = rknpu_mem_destroy_ioctl(rknpu_dev, file, arg);
 		break;
 	case RKNPU_MEM_SYNC:
-		ret = rknpu_mem_sync_ioctl(rknpu_dev, arg);
