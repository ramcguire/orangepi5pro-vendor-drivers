+		 */
+		list_del_init(&job->head[i]);
 	}
 	spin_unlock_irqrestore(&rknpu_dev->irq_lock, flags);
 
@@ -710,7 +738,7 @@ irqreturn_t rknpu_core2_irq_handler(int irq, void *data)
 static void rknpu_job_timeout_clean(struct rknpu_device *rknpu_dev,
 				    int core_mask)
 {
-	struct rknpu_job *job = NULL;
+	struct rknpu_job *job = NULL, *next;
 	unsigned long flags;
 	struct rknpu_subcore_data *subcore_data = NULL;
 	int num_irqs = rknpu_dev->config->num_irqs;
@@ -722,9 +750,15 @@ static void rknpu_job_timeout_clean(struct rknpu_device *rknpu_dev,
 
 		subcore_data = &rknpu_dev->subcore_datas[i];
 		job = subcore_data->job;
-		if (!job ||
+		/*
+		 * opi5: a blocking job belongs to the thread waiting on it
+		 * (it times out and aborts there; its args are on that stack
+		 * and its cleanup_work was never initialised).  timeout is in
+		 * milliseconds, as rknpu_job_wait() treats it.
+		 */
+		if (!job || !(job->flags & RKNPU_JOB_ASYNC) ||
 		    ktime_us_delta(ktime_get(), job->timestamp) <
-			    job->args->timeout)
+			    (s64)job->args->timeout * 1000)
 			continue;
 
 		rknpu_soft_reset(rknpu_dev);
@@ -751,54 +785,101 @@ static void rknpu_job_timeout_clean(struct rknpu_device *rknpu_dev,
 
 		schedule_work(&job->cleanup_work);
 
-		/* Drain remaining queued jobs on this core's todo_list. */
-		do {
-			spin_lock_irqsave(&rknpu_dev->irq_lock, flags);
+		/*
+		 * Drain the async jobs queued on this core's todo_list.  Blocking
+		 * ones stay queued for their waiters (opi5, as above).
+		 */
+		spin_lock_irqsave(&rknpu_dev->irq_lock, flags);
+		list_for_each_entry_safe(job, next, &subcore_data->todo_list,
+					 head[i]) {
+			if (!(job->flags & RKNPU_JOB_ASYNC))
+				continue;
+			/*
+			 * Same care for queued multi-core jobs:
+			 * unlink from every core's todo_list.
+			 */
+			for (j = 0; j < num_irqs; j++)
+				list_del_init(&job->head[j]);
+			schedule_work(&job->cleanup_work);
+		}
+		spin_unlock_irqrestore(&rknpu_dev->irq_lock, flags);
+	}
+}
 
-			if (!list_empty(&subcore_data->todo_list)) {
-				job = list_first_entry(
-					&subcore_data->todo_list,
-					struct rknpu_job, head[i]);
-				/*
-				 * Same care for queued multi-core jobs:
-				 * unlink from every core's todo_list.
-				 */
-				for (j = 0; j < num_irqs; j++) {
-					if (!list_empty(&job->head[j]))
-						list_del_init(&job->head[j]);
-				}
-			} else {
-				job = NULL;
-			}
+/*
+ * opi5: every task range rknpu_job_subcore_commit_pc() may use lies
+ * inside the task buffer.  With one IRQ it uses task_start/task_number;
+ * with several, subcore_task[core] for one or two cores and
+ * subcore_task[core + 2] for three.  An auto mask picks one core later,
+ * so check every core it could pick.
+ */
+static bool rknpu_task_range_ok(__u32 start, __u32 number, size_t count)
+{
+	return number && start < count && number <= count - start &&
+	       start + number <= INT_MAX;
+}
 
-			spin_unlock_irqrestore(&rknpu_dev->irq_lock, flags);
+static int rknpu_check_tasks(struct rknpu_device *rknpu_dev,
+			     struct rknpu_submit *args, size_t size)
+{
+	size_t count = size / sizeof(struct rknpu_task);
+	unsigned int mask = args->core_mask, cores, i;
+
+	if (rknpu_dev->config->num_irqs <= 1)
+		return rknpu_task_range_ok(args->task_start, args->task_number,
+					   count) ? 0 : -EINVAL;
 
-			if (job)
-				schedule_work(&job->cleanup_work);
-		} while (job);
+	if (mask == RKNPU_CORE_AUTO_MASK) {
+		mask = rknpu_dev->core_mask;
+		cores = 1;
+	} else {
+		cores = hweight32(mask);
 	}
+	for (i = 0; i < rknpu_dev->config->num_irqs; i++) {
+		unsigned int index = cores == 3 ? i + 2 : i;
+
+		if (!(mask & rknpu_core_mask(i)))
+			continue;
+		if (index >= ARRAY_SIZE(args->subcore_task) ||
+		    !rknpu_task_range_ok(args->subcore_task[index].task_start,
+					 args->subcore_task[index].task_number,
+					 count))
+			return -EINVAL;
+	}
+	return 0;
 }
 
+/* Consumes the reference on task_obj (DMA_HEAP), whatever it returns. */
 static int rknpu_submit(struct rknpu_device *rknpu_dev,
-			struct rknpu_submit *args)
+			struct rknpu_submit *args,
+			struct rknpu_mem_object *task_obj)
 {
 	struct rknpu_job *job = NULL;
 	int ret = -EINVAL;
 
 	if (args->task_number == 0) {
 		LOG_ERROR("invalid rknpu task number!\n");
-		return -EINVAL;
+		goto err_put;
 	}
 
 	if (args->core_mask > rknpu_dev->core_mask) {
 		LOG_ERROR("invalid rknpu core mask: %#x", args->core_mask);
-		return -EINVAL;
+		goto err_put;
 	}
 
-	job = rknpu_job_alloc(rknpu_dev, args);
+#ifdef CONFIG_ROCKCHIP_RKNPU_DMA_HEAP
+	if (rknpu_check_tasks(rknpu_dev, args, task_obj->size)) {
+		LOG_ERROR("task range outside the task buffer (%zu bytes)\n",
+			  (size_t)task_obj->size);
+		goto err_put;
+	}
+#endif
+
+	job = rknpu_job_alloc(rknpu_dev, args, task_obj);
 	if (!job) {
 		LOG_ERROR("failed to allocate rknpu job!\n");
-		return -ENOMEM;
+		ret = -ENOMEM;
+		goto err_put;
 	}
 
 	if (args->flags & RKNPU_JOB_FENCE_IN) {
@@ -881,6 +962,13 @@ static int rknpu_submit(struct rknpu_device *rknpu_dev,
 	}
 
 	return ret;
+
+err_put:
+#ifdef CONFIG_ROCKCHIP_RKNPU_DMA_HEAP
+	if (task_obj)
+		rknpu_mem_put(task_obj);
+#endif
+	return ret;
 }
 
 #ifdef CONFIG_ROCKCHIP_RKNPU_DRM_GEM
@@ -890,15 +978,25 @@ int rknpu_submit_ioctl(struct drm_device *dev, void *data,
 	struct rknpu_device *rknpu_dev = dev_get_drvdata(dev->dev);
 	struct rknpu_submit *args = data;
 
-	return rknpu_submit(rknpu_dev, args);
+	return rknpu_submit(rknpu_dev, args, NULL);
 }
 #endif
 
 #ifdef CONFIG_ROCKCHIP_RKNPU_DMA_HEAP
 int rknpu_submit_ioctl(struct rknpu_device *rknpu_dev,
+		       struct rknpu_session *session,
 		       struct rknpu_submit *args)
 {
-	return rknpu_submit(rknpu_dev, args);
+	/* opi5: the task buffer must be one of this client's imports. */
+	struct rknpu_mem_object *task_obj =
+		rknpu_mem_get(rknpu_dev, session, args->task_obj_addr);
+
+	if (!task_obj) {
+		LOG_ERROR("submit: task_obj_addr %#llx is not one of this client's buffers\n",
+			  (unsigned long long)args->task_obj_addr);
+		return -EINVAL;
+	}
+	return rknpu_submit(rknpu_dev, args, task_obj);
 }
 #endif
 
diff --git a/drivers/rknpu/src/rknpu_mem.c b/drivers/rknpu/src/rknpu_mem.c
index 677aa82bd858..109f46aac7e7 100644
--- a/drivers/rknpu/src/rknpu_mem.c
+++ b/drivers/rknpu/src/rknpu_mem.c
@@ -258,6 +258,7 @@
 #include <linux/fs.h>
 #include <linux/highmem.h>
 #include <linux/iommu.h>
+#include <linux/kref.h>
 #include <linux/mm.h>
 #include <linux/scatterlist.h>
 #include <linux/slab.h>
@@ -320,6 +321,12 @@ struct rknpu_mem_buf {
 	struct page		**pages;	/* physical pages (both paths) */
 	unsigned long		 nr_pages;	/* number of pages (both paths) */
 	struct iosys_map	 vmap_map;	/* dma_buf_vmap map (import path) */
+	/*
+	 * opi5: one reference for the session list, one per lookup in
+	 * flight (MEM_SYNC) and one per job using it as its task buffer, so
+	 * MEM_DESTROY or close never frees a buffer still in use.
+	 */
+	struct kref		 ref;
 };
 
 /*
@@ -429,6 +436,7 @@ static int rknpu_mem_import(struct rknpu_device *rknpu_dev,
 	 * crashed, or stopped by its container runtime).  Untracked, the
 	 * mapping and the dma-buf reference outlived the process.
 	 */
+	kref_init(&buf->ref);
 	spin_lock(&rknpu_dev->lock);
 	list_add_tail(&buf->mem.head, &session->list);
 	spin_unlock(&rknpu_dev->lock);
@@ -460,10 +468,38 @@ static void rknpu_mem_import_release(struct rknpu_mem_buf *buf)
 	kfree(buf);
 }
 
-/* Free an import already taken off its session list. */
-void rknpu_mem_import_free(struct rknpu_mem_object *obj)
+static void rknpu_mem_buf_release(struct kref *ref)
+{
+	rknpu_mem_import_release(container_of(ref, struct rknpu_mem_buf, ref));
+}
+
+/* Process context only: the last reference unmaps and puts the dma-buf. */
+void rknpu_mem_put(struct rknpu_mem_object *obj)
 {
-	rknpu_mem_import_release(container_of(obj, struct rknpu_mem_buf, mem));
+	kref_put(&container_of(obj, struct rknpu_mem_buf, mem)->ref,
+		 rknpu_mem_buf_release);
+}
+
+struct rknpu_mem_object *rknpu_mem_get(struct rknpu_device *rknpu_dev,
+				       struct rknpu_session *session,
+				       __u64 obj_addr)
+{
+	struct rknpu_mem_object *entry, *found = NULL;
+
+	if (!obj_addr || !session)
+		return NULL;
+
+	spin_lock(&rknpu_dev->lock);
+	list_for_each_entry(entry, &session->list, head) {
+		if ((__u64)(uintptr_t)entry == obj_addr) {
+			kref_get(&container_of(entry, struct rknpu_mem_buf, mem)->ref);
+			found = entry;
+			break;
+		}
+	}
+	spin_unlock(&rknpu_dev->lock);
+
+	return found;
 }
 
 static int rknpu_mem_obj_mmap(struct file *filp, struct vm_area_struct *vma)
@@ -540,6 +576,19 @@ int rknpu_mem_create_ioctl(struct rknpu_device *rknpu_dev, struct file *file,
 		return 0;
 	}
 
+	/*
+	 * opi5: refuse driver-allocated buffers.  librknnrt 2.3.2 in
+	 * DMA_HEAP mode imports every buffer; this path was never taken on
+	 * our boards.  It placed each buffer at a cursor in the NPU's 32-bit
