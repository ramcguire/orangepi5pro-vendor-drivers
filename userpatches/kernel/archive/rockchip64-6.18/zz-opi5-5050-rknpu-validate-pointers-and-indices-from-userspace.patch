 	first_task = &task_base[task_start];
@@ -590,6 +612,12 @@ static void rknpu_job_abort(struct rknpu_job *job)
 					rknpu_get_task_number(job, i);
 			}
 		}
+		/*
+		 * opi5: a multi-core job may still be queued on a core
+		 * that never started it; freed while linked, rknpu_job_next()
