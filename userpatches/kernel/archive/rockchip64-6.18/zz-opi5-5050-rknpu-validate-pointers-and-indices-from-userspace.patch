From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: opi5 <noreply@example.invalid>
Date: Sun, 15 Nov 2026 00:00:00 +0000
Subject: [PATCH] rknpu: validate pointers and indices from userspace

In DMA_HEAP mode, MEM_SYNC's obj_addr and SUBMIT's task_obj_addr were
used as kernel pointers, and task_start/task_number indexed the task
buffer unchecked. Any process with /dev/rknpu could read or corrupt
kernel memory.
- Buffers are reference counted. MEM_SYNC and SUBMIT look obj_addr up
  among the caller's imports and hold a reference; a job holds its task
  buffer until it is freed.
- SUBMIT checks every task range against the task buffer's size, and
  commit checks again.
- MEM_CREATE without a dma-buf is refused (librknnrt doesn't use it, and
  its IOVA cursor never moved back).
- The ioctl argument is zeroed before a short copy_from_user().
- Job list heads are initialised for every core; abort unlinks a job from
  every todo list before freeing it.
- timeout_clean leaves blocking jobs to their waiters, and compares the
  timeout in ms, not us.
---
 drivers/rknpu/src/include/rknpu_job.h |   6 +
 drivers/rknpu/src/include/rknpu_mem.h |  15 ++-
 drivers/rknpu/src/rknpu_drv.c         |  12 +-
 drivers/rknpu/src/rknpu_job.c         | 168 ++++++++++++++++++++------
 drivers/rknpu/src/rknpu_mem.c         |  72 +++++++++--
 5 files changed, 223 insertions(+), 50 deletions(-)

diff --git a/drivers/rknpu/src/include/rknpu_job.h b/drivers/rknpu/src/include/rknpu_job.h
index 8b9e04c3f57b..0581dc4d39b5 100644
--- a/drivers/rknpu/src/include/rknpu_job.h
+++ b/drivers/rknpu/src/include/rknpu_job.h
@@ -26,6 +26,9 @@
 #define RKNPU_CORE1_MASK 0x02
 #define RKNPU_CORE2_MASK 0x04
 
+struct rknpu_mem_object;
+struct rknpu_session;
+
 struct rknpu_job {
 	struct rknpu_device *rknpu_dev;
 	struct list_head head[RKNPU_MAX_CORES];
@@ -49,6 +52,8 @@ struct rknpu_job {
 	ktime_t hw_elapse_time;
 	atomic_t submit_count[RKNPU_MAX_CORES];
 	int iommu_domain_id;
+	/* opi5: the task buffer, referenced for the job's lifetime */
+	struct rknpu_mem_object *task_obj;
 };
 
 irqreturn_t rknpu_core0_irq_handler(int irq, void *data);
@@ -61,6 +66,7 @@ int rknpu_submit_ioctl(struct drm_device *dev, void *data,
 #endif
 #ifdef CONFIG_ROCKCHIP_RKNPU_DMA_HEAP
 int rknpu_submit_ioctl(struct rknpu_device *rknpu_dev,
+		       struct rknpu_session *session,
 		       struct rknpu_submit *args);
 #endif
 
diff --git a/drivers/rknpu/src/include/rknpu_mem.h b/drivers/rknpu/src/include/rknpu_mem.h
index f154957c103b..be6f963b0c17 100644
--- a/drivers/rknpu/src/include/rknpu_mem.h
+++ b/drivers/rknpu/src/include/rknpu_mem.h
@@ -38,11 +38,22 @@ struct rknpu_mem_object {
 	unsigned int owner;
 };
 
+struct rknpu_device;
+struct rknpu_session;
+
 int rknpu_mem_create_ioctl(struct rknpu_device *rknpu_dev, struct file *file,
 			   unsigned int cmd, unsigned long data);
 int rknpu_mem_destroy_ioctl(struct rknpu_device *rknpu_dev, struct file *file,
 			    unsigned long data);
-int rknpu_mem_sync_ioctl(struct rknpu_device *rknpu_dev, unsigned long data);
-void rknpu_mem_import_free(struct rknpu_mem_object *obj);
+int rknpu_mem_sync_ioctl(struct rknpu_device *rknpu_dev, struct file *file,
+			 unsigned long data);
+/*
+ * Look up obj_addr among the session's buffers and take a reference, or
+ * NULL if it is not one of them.  Drop it with rknpu_mem_put().
+ */
+struct rknpu_mem_object *rknpu_mem_get(struct rknpu_device *rknpu_dev,
+				       struct rknpu_session *session,
+				       __u64 obj_addr);
+void rknpu_mem_put(struct rknpu_mem_object *obj);
 
 #endif
diff --git a/drivers/rknpu/src/rknpu_drv.c b/drivers/rknpu/src/rknpu_drv.c
