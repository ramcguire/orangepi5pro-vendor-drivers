 	 * When args_owner is true, job->args points into the tail of the same
 	 * allocation as job (see rknpu_job_alloc). Freeing job also frees args.
@@ -127,7 +132,8 @@ static void rknpu_job_cleanup_work(struct work_struct *work)
 }
 
 static inline struct rknpu_job *rknpu_job_alloc(struct rknpu_device *rknpu_dev,
-						struct rknpu_submit *args)
+						struct rknpu_submit *args,
+						struct rknpu_mem_object *task_obj)
