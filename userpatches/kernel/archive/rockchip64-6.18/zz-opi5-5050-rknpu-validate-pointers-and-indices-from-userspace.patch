 	struct rknpu_job *job = NULL;
 	int i = 0;
@@ -158,6 +164,14 @@ static inline struct rknpu_job *rknpu_job_alloc(struct rknpu_device *rknpu_dev,
 	job->iommu_domain_id = args->iommu_domain_id;
