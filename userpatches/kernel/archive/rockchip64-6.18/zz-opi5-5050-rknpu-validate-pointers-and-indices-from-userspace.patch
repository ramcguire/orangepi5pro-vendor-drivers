diff --git a/drivers/rknpu/src/rknpu_job.c b/drivers/rknpu/src/rknpu_job.c
index c8d5a80083ab..68b092d062a8 100644
--- a/drivers/rknpu/src/rknpu_job.c
+++ b/drivers/rknpu/src/rknpu_job.c
@@ -104,6 +104,11 @@ static void rknpu_job_free(struct rknpu_job *job)
 	if (job->fence)
