From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: opi5 <noreply@example.invalid>
Date: Sun, 15 Nov 2026 00:00:00 +0000
Subject: [PATCH] rknpu: release the NPU core hold once the IOMMU has suspended

The NPU domains and core 1/2 clocks were held from load to unload, so no
NPU domain ever turned off. The hold is needed only while the driver
core can resume the IOMMU itself, at bind and unbind. Release it at the
first power-off with the IOMMU suspended, take it back on exit, and
forbid sysfs unbind, which skips exit.

Still unguarded: writing "on" to the IOMMU's power/control while the
NPU is off.
---
 drivers/rknpu/src/rknpu_drv.c | 82 ++++++++++++++++++++++++++++++++++-
 1 file changed, 80 insertions(+), 2 deletions(-)

diff --git a/drivers/rknpu/src/rknpu_drv.c b/drivers/rknpu/src/rknpu_drv.c
index 185049525399..b2b324b56ad0 100644
--- a/drivers/rknpu/src/rknpu_drv.c
+++ b/drivers/rknpu/src/rknpu_drv.c
@@ -349,6 +349,7 @@ static int rknpu_get_drv_version(uint32_t *version)
 
 static int rknpu_power_on(struct rknpu_device *rknpu_dev);
 static int rknpu_power_off(struct rknpu_device *rknpu_dev);
+static void rknpu_core_hold_release(void);
 
 static void rknpu_power_off_delay_work(struct work_struct *power_off_work)
 {
@@ -1150,6 +1151,8 @@ static int rknpu_power_off(struct rknpu_device *rknpu_dev)
 			pm_runtime_put_sync(rknpu_dev->genpd_dev_npu1);
 		if (rknpu_dev->genpd_dev_npu0)
 			pm_runtime_put_sync(rknpu_dev->genpd_dev_npu0);
+		/* opi5: the IOMMU is suspended; see rknpu_core_hold_release() */
+		rknpu_core_hold_release();
 	}
 
 #ifndef FPGA_PLATFORM
@@ -1342,6 +1345,11 @@ static struct device *rknpu_pinned_genpd[3];	/* [0]=npu0 [1]=npu1 [2]=npu2 */
  * clocks (bus hang / abort). */
 static struct clk *rknpu_pinned_clk[4];		/* aclk1 aclk2 hclk1 hclk2 */
 static bool rknpu_preinit_done;
+/* opi5: under rknpu_hold_lock; rknpu_hold_keep is set once exit begins. */
+static struct platform_device *rknpu_pinned_pdev;
+static bool rknpu_hold_on;
+static bool rknpu_hold_keep;
+static DEFINE_MUTEX(rknpu_hold_lock);
 
 /*
  * True iff the NPU's BOUND iommu node (of_xlate is last-wins, so the LAST
@@ -1877,6 +1885,9 @@ static struct platform_driver rknpu_driver = {
 	.driver = {
 		.owner = THIS_MODULE,
 		.name = "RKNPU",
+		/* opi5: unbind resumes the IOMMU before rknpu_remove(); only
+		 * rknpu_exit() takes the core hold back first. */
+		.suppress_bind_attrs = true,
 #ifndef FPGA_PLATFORM
 		.pm = &rknpu_pm_ops,
 #endif
@@ -1957,6 +1968,8 @@ static void rknpu_preinit_power_domains(void)
 		}
 	}
 	rknpu_preinit_done = true;
+	rknpu_hold_on = true;
+	rknpu_pinned_pdev = pdev;
 	pr_info("rknpu: pre-powered NPU core power domains before driver bind (npu0=%s npu1=%s npu2=%s)\n",
 		rknpu_pinned_genpd[0] ? "ok" : "null",
 		rknpu_pinned_genpd[1] ? "ok" : "null",
@@ -1965,27 +1978,86 @@ static void rknpu_preinit_power_domains(void)
 	/* keep the device ref while pinned; released in rknpu_exit */
 }
 
+/*
+ * opi5: the hold is needed only while the driver core may resume the IOMMU
+ * itself, at bind and unbind; otherwise rknpu resumes it after taking the
+ * domains and clocks. Callers hold rknpu_hold_lock.
+ */
+static void rknpu_core_hold_take(void)
+{
+	int i;
+
+	for (i = 0; i < 3; i++)
+		if (rknpu_pinned_genpd[i])
+			pm_runtime_get_sync(rknpu_pinned_genpd[i]);
+	for (i = 0; i < 4; i++)
+		if (rknpu_pinned_clk[i])
+			clk_prepare_enable(rknpu_pinned_clk[i]);
+	rknpu_hold_on = true;
+}
+
+static void rknpu_core_hold_drop(void)
+{
+	int i;
+
+	for (i = 3; i >= 0; i--)
+		if (rknpu_pinned_clk[i])
+			clk_disable_unprepare(rknpu_pinned_clk[i]);
+	for (i = 2; i >= 0; i--)
+		if (rknpu_pinned_genpd[i])
+			pm_runtime_put_sync(rknpu_pinned_genpd[i]);
+	rknpu_hold_on = false;
+}
+
+/* From rknpu_power_off(), once the IOMMU has suspended. */
+static void rknpu_core_hold_release(void)
+{
+	mutex_lock(&rknpu_hold_lock);
+	if (rknpu_preinit_done && rknpu_hold_on && !rknpu_hold_keep) {
+		rknpu_core_hold_drop();
+		pr_info("rknpu: IOMMU suspended; NPU core power domains and clocks now follow the NPU\n");
+	}
+	mutex_unlock(&rknpu_hold_lock);
+}
+
 static void rknpu_preexit_power_domains(void)
 {
+	bool enabled;
 	int i;
 
 	if (!rknpu_preinit_done)
 		return;
+	/*
+	 * opi5: unbind only queues the IOMMU's suspend: wait for it, and keep the
+	 * domains on if it doesn't come.
+	 */
+	if (readx_poll_timeout(rockchip_iommu_is_enabled,
+			       &rknpu_pinned_pdev->dev, enabled, !enabled,
+			       NPU_MMU_DISABLED_POLL_PERIOD_US,
+			       NPU_MMU_DISABLED_POLL_TIMEOUT_US)) {
+		pr_err("rknpu: IOMMU still enabled at unload; leaving the NPU core power domains on\n");
+		return;
+	}
+	mutex_lock(&rknpu_hold_lock);
+	if (rknpu_hold_on)
+		rknpu_core_hold_drop();
 	for (i = 3; i >= 0; i--) {
 		if (rknpu_pinned_clk[i]) {
-			clk_disable_unprepare(rknpu_pinned_clk[i]);
 			clk_put(rknpu_pinned_clk[i]);
 			rknpu_pinned_clk[i] = NULL;
 		}
 	}
 	for (i = 2; i >= 0; i--) {
 		if (rknpu_pinned_genpd[i]) {
-			pm_runtime_put_sync(rknpu_pinned_genpd[i]);
 			dev_pm_domain_detach(rknpu_pinned_genpd[i], true);
 			rknpu_pinned_genpd[i] = NULL;
 		}
 	}
+	platform_device_put(rknpu_pinned_pdev);
+	rknpu_pinned_pdev = NULL;
 	rknpu_preinit_done = false;
+	rknpu_hold_keep = false;
+	mutex_unlock(&rknpu_hold_lock);
 }
 
 static int rknpu_init(void)
@@ -1996,6 +2068,12 @@ static int rknpu_init(void)
 
 static void rknpu_exit(void)
 {
+	/* opi5: unbind resumes the IOMMU; take the core hold back first */
+	mutex_lock(&rknpu_hold_lock);
+	rknpu_hold_keep = true;
+	if (rknpu_preinit_done && !rknpu_hold_on)
+		rknpu_core_hold_take();
+	mutex_unlock(&rknpu_hold_lock);
 	platform_driver_unregister(&rknpu_driver);
 	rknpu_preexit_power_domains();
 }
