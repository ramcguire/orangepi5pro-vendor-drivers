 drivers/rknpu/src/rknpu_gem.c                 |   6 +-
 drivers/rknpu/src/rknpu_job.c                 |   6 +-
 drivers/rknpu/src/rknpu_mem.c                 | 885 ++++++++++++++++++
 11 files changed, 1270 insertions(+), 41 deletions(-)
 create mode 100644 drivers/rknpu/src/include/compat/linux/devfreq-governor.h
 create mode 100644 drivers/rknpu/src/include/compat/linux/rk-dma-heap.h
 create mode 100644 drivers/rknpu/src/include/compat/rknpu_build_config.h
 create mode 100644 drivers/rknpu/src/rknpu_mem.c

