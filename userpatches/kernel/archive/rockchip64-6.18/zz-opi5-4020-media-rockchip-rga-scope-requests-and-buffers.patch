From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: opi5 <noreply@example.invalid>
Date: Sat, 14 Nov 2026 00:00:00 +0000
Subject: [PATCH] media: rockchip: rga: scope requests and buffers

Any process with /dev/rga could:
- make the RGA access any memory: RGA_PHYSICAL_ADDRESS buffers, and legacy
  uv_addr without mmu_flag, were used as given. Require CAP_SYS_RAWIO at
  open; kernel callers keep access.
- make the kernel use any address as a struct dma_buf: RGA_IOC_IMPORT_BUFFER
  accepted RGA_DMA_BUFFER_PTR, whose memory is a kernel pointer meant for
  in-kernel callers (rga_mpi_commit). Refuse it from userspace.
- free a request in use: ids are global, and cancel, completion and exit
  each dropped the id's reference. Cancel, config and submit now need the
  caller's own request, and the id's reference is dropped once.
- free a buffer in use: handles are global, release didn't count imports,
  and exit kfree()d buffers that other clients or jobs held. Imports are
  now per session and counted, release and exit drop only imports, and
  jobs use only their own session's handles.
---
 .../rockchip/rga/rga3/include/rga_drv.h       | 13 +++
 .../rockchip/rga/rga3/include/rga_job.h       |  3 +-
 .../rockchip/rga/rga3/include/rga_mm.h        |  2 +-
 .../platform/rockchip/rga/rga3/rga_drv.c      | 55 +++++++++---
 .../platform/rockchip/rga/rga3/rga_job.c      | 31 +++++--
 .../media/platform/rockchip/rga/rga3/rga_mm.c | 87 ++++++++++++++++---
 6 files changed, 158 insertions(+), 33 deletions(-)

diff --git a/drivers/media/platform/rockchip/rga/rga3/include/rga_drv.h b/drivers/media/platform/rockchip/rga/rga3/include/rga_drv.h
index 1e9cbd5bfdeb..72e2a4085bda 100644
--- a/drivers/media/platform/rockchip/rga/rga3/include/rga_drv.h
+++ b/drivers/media/platform/rockchip/rga/rga3/include/rga_drv.h
@@ -232,6 +232,11 @@ struct rga_internal_buffer {
 
 	struct kref refcount;
 	struct rga_session *session;
+	/*
+	 * opi5 (experimental): imports not yet released, under mm->lock.
+	 * Release drops only these, never the references jobs hold.
+	 */
+	int import_count;
 
 	/* The scheduler of the mapping */
 	struct rga_scheduler_t *scheduler;
@@ -251,6 +256,12 @@ struct rga_session {
 	bool release;
 	struct rw_semaphore release_rwsem;
 	struct kref refcount;
+	/*
+	 * opi5 (experimental): may use physical addresses (the opener had
+	 * CAP_SYS_RAWIO, or a kernel caller).  RGA maps them as given, so
+	 * otherwise any client could make the RGA read or write any memory.
+	 */
+	bool allow_phys;
 };
 
 struct rga_job_buffer {
@@ -399,6 +410,8 @@ struct rga_request {
 	uint8_t mpi_config_flags;
 	int id;
 	struct rga_session *session;
+	/* opi5 (experimental): the id's reference was dropped (cancel or exit) */
+	bool id_released;
 
 	spinlock_t lock;
 	struct kref refcount;
diff --git a/drivers/media/platform/rockchip/rga/rga3/include/rga_job.h b/drivers/media/platform/rockchip/rga/rga3/include/rga_job.h
