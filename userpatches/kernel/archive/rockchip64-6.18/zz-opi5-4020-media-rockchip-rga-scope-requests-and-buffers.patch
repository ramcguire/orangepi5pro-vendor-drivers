+++ b/drivers/media/platform/rockchip/rga/rga3/include/rga_job.h
@@ -44,7 +44,8 @@ void rga_request_get(struct rga_request *request);
 int rga_request_free(struct rga_request *request);
 int rga_request_alloc(uint32_t flags, struct rga_session *session);
 
-struct rga_request *rga_request_config(struct rga_user_request *user_request);
+struct rga_request *rga_request_config(struct rga_user_request *user_request,
+				       struct rga_session *session);
 struct rga_request *rga_request_kernel_config(struct rga_user_request *user_request);
 int rga_request_submit(struct rga_request *request);
 int rga_request_mpi_submit(struct rga_req *req, struct rga_request *request);
diff --git a/drivers/media/platform/rockchip/rga/rga3/include/rga_mm.h b/drivers/media/platform/rockchip/rga/rga3/include/rga_mm.h
index a75f2470b928..bddb05c9454b 100644
--- a/drivers/media/platform/rockchip/rga/rga3/include/rga_mm.h
+++ b/drivers/media/platform/rockchip/rga/rga3/include/rga_mm.h
@@ -58,7 +58,7 @@ void rga_mm_unmap_job_info(struct rga_job *job);
 
 int rga_mm_import_buffer(struct rga_external_buffer *external_buffer,
 			 struct rga_session *session);
-int rga_mm_release_buffer(uint32_t handle);
+int rga_mm_release_buffer(uint32_t handle, struct rga_session *session);
 int rga_mm_session_release_buffer(struct rga_session *session);
 
 int rga_mm_init(struct rga_mm **session);
diff --git a/drivers/media/platform/rockchip/rga/rga3/rga_drv.c b/drivers/media/platform/rockchip/rga/rga3/rga_drv.c
index 5bc4cda16148..cbd2e16c6127 100644
--- a/drivers/media/platform/rockchip/rga/rga3/rga_drv.c
+++ b/drivers/media/platform/rockchip/rga/rga3/rga_drv.c
@@ -243,11 +243,11 @@ int rga_mpi_commit(struct rga_mpi_job_t *mpi_job)
 
 err_put_request:
 	if ((mpi_job->dma_buf_src0 != NULL) && (mpi_cmd.src.yrgb_addr > 0))
-		rga_mm_release_buffer(mpi_cmd.src.yrgb_addr);
+		rga_mm_release_buffer(mpi_cmd.src.yrgb_addr, request->session);
 	if ((mpi_job->dma_buf_src1 != NULL) && (mpi_cmd.pat.yrgb_addr > 0))
-		rga_mm_release_buffer(mpi_cmd.pat.yrgb_addr);
+		rga_mm_release_buffer(mpi_cmd.pat.yrgb_addr, request->session);
 	if ((mpi_job->dma_buf_dst != NULL) && (mpi_cmd.dst.yrgb_addr > 0))
-		rga_mm_release_buffer(mpi_cmd.dst.yrgb_addr);
+		rga_mm_release_buffer(mpi_cmd.dst.yrgb_addr, request->session);
 
 err_release_rwsem:
 	up_read(&request->session->release_rwsem);
@@ -272,6 +272,7 @@ int rga_kernel_commit(struct rga_req *cmd)
 	session = rga_session_init();
 	if (IS_ERR(session))
 		return PTR_ERR(session);
+	session->allow_phys = true;	/* opi5: kernel caller */
 
 	down_read(&session->release_rwsem);
 
@@ -655,6 +656,20 @@ static long rga_ioctl_import_buffer(unsigned long arg, struct rga_session *sessi
 		goto err_free_external_buffer;
 	}
 
+	/*
+	 * opi5 (experimental): RGA_DMA_BUFFER_PTR's memory is a kernel
+	 * struct dma_buf pointer, for in-kernel callers (rga_mpi_commit).
+	 * From userspace it was attached and mapped as given.  Check every
+	 * buffer before importing any, so a refusal leaves nothing imported.
+	 */
+	for (i = 0; i < buffer_pool.size; i++) {
+		if (external_buffer[i].type == RGA_DMA_BUFFER_PTR) {
+			rga_err("buffer[%d] dma_buf pointer refused from userspace\n", i);
+			ret = -EINVAL;
+			goto err_free_external_buffer;
+		}
+	}
+
 	for (i = 0; i < buffer_pool.size; i++) {
 		if (DEBUGGER_EN(MSG)) {
 			rga_log("import buffer info:\n");
@@ -688,7 +703,7 @@ static long rga_ioctl_import_buffer(unsigned long arg, struct rga_session *sessi
 	return ret;
 }
 
-static long rga_ioctl_release_buffer(unsigned long arg)
+static long rga_ioctl_release_buffer(unsigned long arg, struct rga_session *session)
 {
 	int i;
 	int ret = 0;
@@ -733,7 +748,7 @@ static long rga_ioctl_release_buffer(unsigned long arg)
 		if (DEBUGGER_EN(MSG))
 			rga_log("release buffer handle[%d]\n", external_buffer[i].handle);
 
-		ret = rga_mm_release_buffer(external_buffer[i].handle);
+		ret = rga_mm_release_buffer(external_buffer[i].handle, session);
 		if (ret < 0) {
 			rga_err("buffer[%d] mm release buffer failed! handle = %d\n",
 			       i, external_buffer[i].handle);
@@ -767,7 +782,8 @@ static long rga_ioctl_request_create(unsigned long arg, struct rga_session *sess
 	return 0;
 }
 
-static long rga_ioctl_request_submit(unsigned long arg, bool run_enbale)
+static long rga_ioctl_request_submit(unsigned long arg, bool run_enbale,
+				     struct rga_session *session)
 {
 	int ret = 0;
 	struct rga_pending_request_manager *request_manager = NULL;
@@ -792,7 +808,7 @@ static long rga_ioctl_request_submit(unsigned long arg, bool run_enbale)
 	if (DEBUGGER_EN(MSG))
 		rga_log("config request id = %d", user_request.id);
 
-	request = rga_request_config(&user_request);
+	request = rga_request_config(&user_request, session);
 	if (IS_ERR_OR_NULL(request)) {
 		rga_err("request[%d] config failed!\n", user_request.id);
 		return -EFAULT;
@@ -822,7 +838,7 @@ static long rga_ioctl_request_submit(unsigned long arg, bool run_enbale)
 	return 0;
 }
 
-static long rga_ioctl_request_cancel(unsigned long arg)
+static long rga_ioctl_request_cancel(unsigned long arg, struct rga_session *session)
 {
 	uint32_t id;
 	struct rga_pending_request_manager *request_manager;
@@ -851,6 +867,17 @@ static long rga_ioctl_request_cancel(unsigned long arg)
 		return -EINVAL;
 	}
 
+	/*
+	 * opi5 (experimental): cancel drops the id's reference.  Another
+	 * session's cancel, a second cancel, or a cancel before exit (which
+	 * drops it again) freed a request a job still used.
+	 */
+	if (request->session != session || request->id_released) {
+		rga_err("request id[%d] is not this session's to cancel", id);
+		mutex_unlock(&request_manager->lock);
+		return -EINVAL;
+	}
+	request->id_released = true;
 	rga_request_put(request);
 
 	mutex_unlock(&request_manager->lock);
@@ -886,7 +913,7 @@ static long rga_ioctl_blit(unsigned long arg, uint32_t cmd, struct rga_session *
 		goto err_free_request_by_id;
 	}
 
-	request = rga_request_config(&user_request);
+	request = rga_request_config(&user_request, session);
 	if (IS_ERR(request)) {
 		rga_err("ID[%d]: config failed!\n", user_request.id);
 		ret = -EFAULT;
@@ -1068,7 +1095,7 @@ static long rga_ioctl(struct file *file, uint32_t cmd, unsigned long arg)
 	case RGA_IOC_RELEASE_BUFFER:
 		rga_power_enable_all();
 
-		ret = rga_ioctl_release_buffer(arg);
+		ret = rga_ioctl_release_buffer(arg, session);
 
 		rga_power_disable_all();
 
@@ -1080,17 +1107,17 @@ static long rga_ioctl(struct file *file, uint32_t cmd, unsigned long arg)
 		break;
 
 	case RGA_IOC_REQUEST_SUBMIT:
-		ret = rga_ioctl_request_submit(arg, true);
+		ret = rga_ioctl_request_submit(arg, true, session);
 
 		break;
 
 	case RGA_IOC_REQUEST_CONFIG:
-		ret = rga_ioctl_request_submit(arg, false);
+		ret = rga_ioctl_request_submit(arg, false, session);
 
 		break;
 
 	case RGA_IOC_REQUEST_CANCEL:
-		ret = rga_ioctl_request_cancel(arg);
+		ret = rga_ioctl_request_cancel(arg, session);
 
 		break;
 
@@ -1156,6 +1183,8 @@ static int rga_open(struct inode *inode, struct file *file)
 	session = rga_session_init();
 	if (IS_ERR(session))
 		return PTR_ERR(session);
+	/* opi5 (experimental): Docker drops CAP_SYS_RAWIO from containers */
+	session->allow_phys = capable(CAP_SYS_RAWIO);
 
 	file->private_data = (void *)session;
 
diff --git a/drivers/media/platform/rockchip/rga/rga3/rga_job.c b/drivers/media/platform/rockchip/rga/rga3/rga_job.c
index 47d2034af90d..2d5b5c44968c 100644
--- a/drivers/media/platform/rockchip/rga/rga3/rga_job.c
+++ b/drivers/media/platform/rockchip/rga/rga3/rga_job.c
@@ -836,8 +836,11 @@ static void rga_request_release_abort(struct rga_request *request, int err_code)
 	rga_dma_fence_signal(request->release_fence, err_code);
 
 	mutex_lock(&request_manager->lock);
-	/* current submit request put */
-	rga_request_put(request);
+	/* current submit request put: the id's reference (opi5: once) */
+	if (!request->id_released) {
+		request->id_released = true;
+		rga_request_put(request);
+	}
 	mutex_unlock(&request_manager->lock);
 }
 
@@ -856,9 +859,10 @@ void rga_request_session_destroy_abort(struct rga_session *session)
 	mutex_lock(&request_manager->lock);
 
 	idr_for_each_entry(&request_manager->request_idr, request, request_id) {
-		if (session == request->session) {
+		if (session == request->session && !request->id_released) {
 			rga_req_err(request, "destroy when the user exits, current refcount = %d\n",
 				kref_read(&request->refcount));
+			request->id_released = true;
 			rga_request_put(request);
 		}
 	}
@@ -1053,9 +1057,16 @@ int rga_request_release_signal(struct rga_scheduler_t *scheduler, struct rga_job
 		if (DEBUGGER_EN(MSG))
 			rga_job_log(job, "finished %d failed %d\n", finished_count, failed_count);
 
-		/* current submit request put */
+		/*
+		 * current submit request put: the id's reference.  opi5
+		 * (experimental): cancel, exit and finishing each dropped it;
+		 * only the first may.
+		 */
 		mutex_lock(&request_manager->lock);
-		rga_request_put(request);
+		if (!request->id_released) {
+			request->id_released = true;
+			rga_request_put(request);
+		}
 		mutex_unlock(&request_manager->lock);
 	}
 
@@ -1085,7 +1096,8 @@ int rga_request_release_signal(struct rga_scheduler_t *scheduler, struct rga_job
 	return 0;
 }
 
-struct rga_request *rga_request_config(struct rga_user_request *user_request)
+struct rga_request *rga_request_config(struct rga_user_request *user_request,
+				       struct rga_session *session)
 {
 	int ret;
 	unsigned long flags;
@@ -1108,6 +1120,13 @@ struct rga_request *rga_request_config(struct rga_user_request *user_request)
 		return ERR_PTR(-EINVAL);
 	}
 
+	/* opi5 (experimental): request ids are global; use only our own */
+	if (request->session != session || request->id_released) {
+		rga_err("request id[%d] is not this session's", user_request->id);
+		mutex_unlock(&request_manager->lock);
+		return ERR_PTR(-EINVAL);
+	}
+
 	rga_request_get(request);
 	mutex_unlock(&request_manager->lock);
 
diff --git a/drivers/media/platform/rockchip/rga/rga3/rga_mm.c b/drivers/media/platform/rockchip/rga/rga3/rga_mm.c
