+	u32 irq_mask;
+	u32 status_base;
+	u32 status_mask;
+	u32 err_mask;
+	u32 ip_reset_mask;
+	u32 ip_time_base;
+	u32 en_base;
+	u32 ip_en_base;
+	u32 ip_en_val;
+
+	u32 en_sw_iommu_zap;
+};
+
+struct rkvdec_link_dev {
+	struct device *dev;
+	struct mpp_dev *mpp;
+	void __iomem *reg_base;
+	u32 enabled;
+	u32 link_mode;
+	u32 decoded_status;
+	u32 irq_status;
+	u32 iova_curr;
+	u32 iova_next;
+	u32 decoded;
+	u32 total;
+	u32 error;
