+	u32 link_reg_count;
+
+	/* taskqueue variables */
+	u32 task_running;
+	atomic_t task_pending;
+	/* timeout can be trigger in different thread so atomic is needed */
+	atomic_t task_timeout;
+	u32 task_timeout_prev;
+
+	/* link mode hardware status */
