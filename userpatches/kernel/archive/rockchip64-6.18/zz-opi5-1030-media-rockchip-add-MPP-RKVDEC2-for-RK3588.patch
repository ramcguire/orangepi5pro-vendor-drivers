From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: opi5 <noreply@example.invalid>
Date: Sat, 8 Aug 2026 00:00:00 +0000
Subject: [PATCH] media: rockchip: add MPP RKVDEC2 for RK3588

Both VDPU381 decoder cores and their linked-core CCU scheduler. Devfreq
needs vendor OPP code and sits behind ROCKCHIP_MPP_RKVDEC2_DEVFREQ, which
doesn't exist, so the cores run at a fixed clock. The vendor reset SMC is
replaced by the per-core reset.

Origin: https://github.com/rockchip-linux/kernel b4ef083dc0c3 (develop-6.1)
---
 drivers/media/platform/rockchip/mpp/Kconfig   |    6 +
 drivers/media/platform/rockchip/mpp/Makefile  |    1 +
 .../mpp/hack/mpp_rkvdec2_hack_rk3568.c        |  732 +++++
 .../mpp/hack/mpp_rkvdec2_link_hack_rk3568.c   |  213 ++
 .../media/platform/rockchip/mpp/mpp_rkvdec2.c | 2230 ++++++++++++++
 .../media/platform/rockchip/mpp/mpp_rkvdec2.h |  234 ++
 .../platform/rockchip/mpp/mpp_rkvdec2_link.c  | 2716 +++++++++++++++++
 .../platform/rockchip/mpp/mpp_rkvdec2_link.h  |  257 ++
 8 files changed, 6389 insertions(+)
 create mode 100644 drivers/media/platform/rockchip/mpp/hack/mpp_rkvdec2_hack_rk3568.c
 create mode 100644 drivers/media/platform/rockchip/mpp/hack/mpp_rkvdec2_link_hack_rk3568.c
 create mode 100644 drivers/media/platform/rockchip/mpp/mpp_rkvdec2.c
 create mode 100644 drivers/media/platform/rockchip/mpp/mpp_rkvdec2.h
 create mode 100644 drivers/media/platform/rockchip/mpp/mpp_rkvdec2_link.c
 create mode 100644 drivers/media/platform/rockchip/mpp/mpp_rkvdec2_link.h

diff --git a/drivers/media/platform/rockchip/mpp/Kconfig b/drivers/media/platform/rockchip/mpp/Kconfig
index dd4145803229..687ec59f1f20 100644
--- a/drivers/media/platform/rockchip/mpp/Kconfig
+++ b/drivers/media/platform/rockchip/mpp/Kconfig
@@ -18,4 +18,10 @@ config ROCKCHIP_MPP_PROC_FS
 	help
 	  Expose read-only MPP service diagnostics in procfs.
 
+config ROCKCHIP_MPP_RKVDEC2
+	bool "RK3588 MPP RKVDEC2 decoder"
+	help
+	  Bind the two RK3588 VDPU381 decoder cores and their CCU through
+	  the MPP request ABI. This conflicts with VIDEO_ROCKCHIP_VDEC.
+
 endif
diff --git a/drivers/media/platform/rockchip/mpp/Makefile b/drivers/media/platform/rockchip/mpp/Makefile
index 5fa3a26e046a..4ce54990015c 100644
--- a/drivers/media/platform/rockchip/mpp/Makefile
+++ b/drivers/media/platform/rockchip/mpp/Makefile
@@ -4,4 +4,5 @@
 ccflags-y += -DMPP_VERSION=\"b4ef083dc0c3608e744deabb43dc6b781aadbe6e\"
 
 rk_vcodec-y := mpp_service.o mpp_common.o mpp_iommu.o
+rk_vcodec-$(CONFIG_ROCKCHIP_MPP_RKVDEC2) += mpp_rkvdec2.o mpp_rkvdec2_link.o
 obj-$(CONFIG_ROCKCHIP_MPP_SERVICE) += rk_vcodec.o
diff --git a/drivers/media/platform/rockchip/mpp/hack/mpp_rkvdec2_hack_rk3568.c b/drivers/media/platform/rockchip/mpp/hack/mpp_rkvdec2_hack_rk3568.c
new file mode 100644
index 000000000000..0c20dd9c5923
--- /dev/null
+++ b/drivers/media/platform/rockchip/mpp/hack/mpp_rkvdec2_hack_rk3568.c
@@ -0,0 +1,732 @@
