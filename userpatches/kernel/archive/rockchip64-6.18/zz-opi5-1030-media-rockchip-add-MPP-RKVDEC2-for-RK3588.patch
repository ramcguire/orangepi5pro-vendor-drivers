+int rkvdec2_link_remove(struct mpp_dev *mpp, struct rkvdec_link_dev *link_dec)
+{
+	mpp_debug_enter();
+
+	if (link_dec && link_dec->table) {
+		mpp_dma_free(link_dec->table);
+		link_dec->table = NULL;
+	}
+
+	mpp_debug_leave();
+
+	return 0;
+}
