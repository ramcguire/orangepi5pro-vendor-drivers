+#ifdef CONFIG_ROCKCHIP_MPP_PROC_FS
+static int rkvdec2_procfs_remove(struct mpp_dev *mpp)
+{
+	struct rkvdec2_dev *dec = to_rkvdec2_dev(mpp);
+
+	if (dec->procfs) {
+		proc_remove(dec->procfs);
+		dec->procfs = NULL;
