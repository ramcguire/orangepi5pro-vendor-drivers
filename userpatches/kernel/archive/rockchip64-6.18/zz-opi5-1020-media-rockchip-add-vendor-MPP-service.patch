+# SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+
+menuconfig ROCKCHIP_MPP_SERVICE
+	tristate "Rockchip MPP service framework"
+	depends on ARCH_ROCKCHIP && IOMMU_SUPPORT
+	select DMA_SHARED_BUFFER
+	help
+	  Build the shared Rockchip MPP session, DMA-buffer, and IOMMU service.
+	  This base alone exposes no codec hardware. Select a reviewed MPP codec
+	  driver only in an isolated profile that owns its device-tree nodes.
+
+if ROCKCHIP_MPP_SERVICE
+
+config ROCKCHIP_MPP_PROC_FS
+	bool "MPP service procfs diagnostics"
+	depends on PROC_FS
+	default y
+	help
+	  Expose read-only MPP service diagnostics in procfs.
+
+endif
