 .../media/platform/rockchip/rga/rga3/Makefile |  1 +
 .../rockchip/rga/rga3/include/rga_job.h       | 28 +++++-
 .../rockchip/rga/rga3/include/rga_mm.h        | 21 +++++
 .../platform/rockchip/rga/rga3/rga_job.c      | 26 ------
 .../platform/rockchip/rga/rga3/rga_kunit.c    | 91 +++++++++++++++++++
 .../media/platform/rockchip/rga/rga3/rga_mm.c | 18 +---
 7 files changed, 152 insertions(+), 43 deletions(-)
 create mode 100644 drivers/media/platform/rockchip/rga/rga3/rga_kunit.c

diff --git a/drivers/media/platform/rockchip/rga/rga3/Kconfig b/drivers/media/platform/rockchip/rga/rga3/Kconfig
index ce87ffea12f7..89f07d4b87dd 100644
--- a/drivers/media/platform/rockchip/rga/rga3/Kconfig
+++ b/drivers/media/platform/rockchip/rga/rga3/Kconfig
@@ -58,4 +58,14 @@ config ROCKCHIP_RGA_CMD_BUF_COUNT
 	  This option configures the number of command buffers (cmd_buf) that are
 	  pre-allocated by the RGA driver during initialization.
 
+config ROCKCHIP_RGA_KUNIT_TEST
+	tristate "KUnit tests for the multi-RGA driver" if !KUNIT_ALL_TESTS
+	depends on KUNIT
+	default KUNIT_ALL_TESTS
+	help
+	  Tests for the RGA request filter and the one-base-address rule for
+	  IOMMU-type cores, as the rga_kunit module. Loading it runs them and
+	  taints the kernel. It doesn't need rga3.ko, which only loads on
+	  a board with RGA cores.
+
 endif
diff --git a/drivers/media/platform/rockchip/rga/rga3/Makefile b/drivers/media/platform/rockchip/rga/rga3/Makefile
index ccc68c7990dd..2cf1d23a4e78 100644
--- a/drivers/media/platform/rockchip/rga/rga3/Makefile
+++ b/drivers/media/platform/rockchip/rga/rga3/Makefile
@@ -7,3 +7,4 @@ rga3-$(CONFIG_ROCKCHIP_RGA_ASYNC) += rga_fence.o
 rga3-$(CONFIG_ROCKCHIP_RGA_DEBUGGER) += rga_debugger.o
 
 obj-$(CONFIG_ROCKCHIP_MULTI_RGA)	+= rga3.o
+obj-$(CONFIG_ROCKCHIP_RGA_KUNIT_TEST)	+= rga_kunit.o
diff --git a/drivers/media/platform/rockchip/rga/rga3/include/rga_job.h b/drivers/media/platform/rockchip/rga/rga3/include/rga_job.h
index 67d16649aaf4..0dac131f3653 100644
--- a/drivers/media/platform/rockchip/rga/rga3/include/rga_job.h
+++ b/drivers/media/platform/rockchip/rga/rga3/include/rga_job.h
@@ -12,6 +12,7 @@
 #include <linux/dma-fence.h>
 
 #include "rga_drv.h"
+#include "rga_common.h"
 
 enum job_flags {
 	RGA_JOB_DONE			= 1 << 0,
@@ -31,7 +32,32 @@ int rga_job_mpi_commit(struct rga_req *rga_command_base, struct rga_request *req
 int rga_job_assign(struct rga_job *job);
 
 
-int rga_request_check(struct rga_user_request *req);
+/* Inline, so rga_kunit tests it without rga3.ko, which needs RGA cores to load. */
+static inline int rga_request_check(struct rga_user_request *req)
+{
+	if (req->id <= 0) {
+		rga_err("ID[%d]: request_id is invalid", req->id);
+		return -EINVAL;
+	}
+
+	if (req->task_num <= 0) {
+		rga_err("ID[%d]: invalid user request!\n", req->id);
+		return -EINVAL;
+	}
+
+	if (req->task_ptr == 0) {
+		rga_err("ID[%d]: task_ptr is NULL!\n", req->id);
+		return -EINVAL;
+	}
+
+	if (req->task_num > RGA_TASK_NUM_MAX) {
+		rga_err("ID[%d]: Only supports running %d tasks, now %d\n",
+			req->id, RGA_TASK_NUM_MAX, req->task_num);
+		return -EFBIG;
+	}
+
+	return 0;
+}
 struct rga_request *rga_request_lookup(struct rga_pending_request_manager *request_manager,
 				       uint32_t id);
 
diff --git a/drivers/media/platform/rockchip/rga/rga3/include/rga_mm.h b/drivers/media/platform/rockchip/rga/rga3/include/rga_mm.h
index bddb05c9454b..c4f828c6e58e 100644
--- a/drivers/media/platform/rockchip/rga/rga3/include/rga_mm.h
+++ b/drivers/media/platform/rockchip/rga/rga3/include/rga_mm.h
@@ -64,4 +64,25 @@ int rga_mm_session_release_buffer(struct rga_session *session);
 int rga_mm_init(struct rga_mm **session);
 int rga_mm_remove(struct rga_mm **session);
 
+/*
+ * RGA3/RGA2 IOMMU-type cores program exactly one base address
+ * per plane; they have no per-job scatter-gather descriptor.
+ * rga_dma_map_sgt() can still return more than one DMA segment
+ * for a user virtual-address buffer whose physical pages this
+ * IOMMU backend did not coalesce into a single IOVA run (seen
+ * even with an unbounded dma_max_seg_size for buffers with
+ * enough physical scatter). Treating buffer->dma_addr as the
+ * base of the whole buffer would then be wrong for any byte
+ * past the first segment, and the core's internal MMU/TLB
+ * faults on the resulting bad address mid-job, forcing a
+ * hardware reset. Reject in software instead of letting that
+ * reach hardware.
+ *
+ * Inline, so rga_kunit tests it without rga3.ko, which needs RGA cores to load.
+ */
+static inline int rga_mm_check_sgt_single_base(const struct sg_table *sgt)
+{
+	return sgt->nents > 1 ? -EOPNOTSUPP : 0;
+}
+
 #endif
diff --git a/drivers/media/platform/rockchip/rga/rga3/rga_job.c b/drivers/media/platform/rockchip/rga/rga3/rga_job.c
