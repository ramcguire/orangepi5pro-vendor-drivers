// The version here is hk's in mise.toml.
amends "package://github.com/jdx/hk/releases/download/v2.14.0/hk@2.14.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.14.0/hk@2.14.0#/Builtins.pkl"

steps {
  ["shellcheck"] = Builtins.shellcheck
  ["actionlint"] = Builtins.actionlint
  ["shebang_scripts_are_executable"] = Builtins.check_shebang_scripts_are_executable
  ["executables_have_shebangs"] = Builtins.check_executables_have_shebangs
  ["merge_conflict"] = Builtins.check_merge_conflict
  ["case_conflict"] = Builtins.check_case_conflict
  ["editorconfig"] = (Builtins.editorconfig_checker) {
    // Patches are byte-exact; overlays/ is generated.
    exclude = List("userpatches/**/*.patch", "overlays/**")
  }
}

// Conventional Commits (https://www.conventionalcommits.org): <type>(<scope>)!: <description>.
hooks {
  ["commit-msg"] {
    steps {
      ["conventional_commit"] = Builtins.check_conventional_commit
    }
  }
}
